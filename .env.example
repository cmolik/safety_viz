# Build-time configuration for local development (Vite).
# Copy to `.env` and adjust. Only variables prefixed SAFETY_VIZ_ are exposed
# to the app (see vite.config.ts `envPrefix`).
#
# In Docker these are NOT used — the container reads API_URL / BASENAME env
# vars at startup instead (runtime config via public/config.js; see README).

# Base URL of the CL01000136-V2 "Knowledge base" backend (required).
SAFETY_VIZ_API_URL=http://localhost:3001

# Router base path when the app is served from a sub-path (optional, default "").
SAFETY_VIZ_BASENAME=
